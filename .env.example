# Copy to .env and replace these placeholders. Never commit real credentials.
# Use a hostname reachable from the container, not localhost on the Docker host.
DATABASE_URL=postgresql://coffee:REPLACE_ME@postgres.your-tailnet.ts.net:5432/coffee
# Set to the exact browser-facing origin, with no trailing slash.
APP_ORIGIN=https://coffee.your-tailnet.ts.net
